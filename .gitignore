# ── Dépendances ──────────────────────────────────────────────────────────────
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Builds (ne jamais committer les sorties) ─────────────────────────────────
/build
frontend/build/
dist/
frontend/dist/

# ── Environnement ─────────────────────────────────────────────────────────────
*.env
*.env.*
*token.json*
*credentials.json*
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ──────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# ── IDE / éditeurs ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Système ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── Cache ─────────────────────────────────────────────────────────────────────
.cache/
.vite/
frontend/.vite/
/coverage

# ── Claude Code (configuration locale, ne pas partager) ───────────────────────
.claude/

# ── Déploiement (configurations hébergeur) ────────────────────────────────────
.vercel

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
venv/
.venv/
.ipynb_checkpoints/

# ── Archives ──────────────────────────────────────────────────────────────────
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
